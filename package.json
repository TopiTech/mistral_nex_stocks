{
  "name": "mistral-nex-stocks",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run typecheck && npm run compile && npm run verify-generated && npm run lint && npx prettier --check \"static/js/**/*.js\" \"chrome_extension/**/*.js\"",
    "compile": "tsc -p tsconfig.json && prettier --write static/js/api_client.js",
    "verify-generated": "node scripts/verify_generated_frontend.mjs",
    "format": "prettier --write \"static/js/**/*.js\" \"chrome_extension/**/*.js\"",
    "lint": "eslint \"static/js/**/*.js\" \"chrome_extension/**/*.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "prettier": "3.9.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion": "^1.1.18",
    "js-yaml": "^4.3.1"
  }
}
